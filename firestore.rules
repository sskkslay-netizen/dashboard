rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/data/{dataId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function isSupportedRecord() {
        return dataId in ['studyArchiveData', 'studyArchiveACT']
          && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 870400;
      }

      allow read: if isOwner()
        && dataId in ['studyArchiveData', 'studyArchiveACT'];
      allow create, update: if isOwner() && isSupportedRecord();
      allow delete: if false;
    }

    match /sharedData/{dataId} {
      function isDeveloper() {
        return request.auth != null
          && request.auth.uid in [];
      }

      function isValidCardCatalog() {
        return request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 870400;
      }

      allow read: if dataId == 'cards';
      allow create, update: if dataId == 'cards'
        && isDeveloper()
        && isValidCardCatalog();
      allow delete: if false;
    }
  }
}
