rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isDeveloper() {
      return request.auth != null
        && request.auth.uid in ['akpQXd1NFneCRiQjYPDpBsJU8zD2'];
    }

    match /shared-cards/{cardId}/{fileName} {
      allow read: if true;
      allow create, update: if isDeveloper()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if isDeveloper();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
